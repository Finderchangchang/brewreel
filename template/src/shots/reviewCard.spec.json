{
  "type": "reviewCard",
  "purpose": "引用真实顾客评价：只能摘原文，可以删减，不能改写得更夸张。行业规则会核对 text 是不是 brief.reviews 某条原文的子串（reviewVerbatim）。",
  "tips": [
    "quotes 最多 2 条；不放真人头像，改用首字母圆标；抖音版不写来源平台名，防止被判导流",
    "教培禁用这个镜头（依据《广告法》第二十四条第（三）项，行业规则里按 industry 禁用）；电商可用，但要求隐去昵称",
    "evidence 是评价截图的路径，不上屏，只给校验和人看"
  ],
  "dur": {"default": 3, "min": 2, "max": 4.5},
  "mood": 0.15,
  "caption": "optional",
  "exit": "push",
  "params": {
    "type": "object",
    "required": ["quotes", "evidence"],
    "properties": {
      "quotes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "required": ["text", "month"],
          "properties": {
            "text": {"type": "string", "maxLen": 24, "description": "原文摘录，可删减不可改写得更夸张"},
            "month": {"type": "string", "maxLen": 7, "description": "评价月份，如 2026-08"},
            "stars": {"type": "integer", "minimum": 1, "maximum": 5, "description": "必须和原评价一致"},
            "who": {"type": "string", "maxLen": 8, "description": "如「亲子住客」，不写真名"}
          }
        }
      },
      "evidence": {"type": "string", "format": "note", "maxLen": 80, "description": "评价截图的路径，不上屏"}
    }
  },
  "sfx": [{"at": 0.05, "kind": "pop", "vol": 0.2}, {"at": 0.3, "kind": "swish", "vol": 0.16}],
  "example": {
    "mood": 0.15,
    "dur": 3,
    "params": {
      "quotes": [{"text": "排队不久，分量很足", "month": "2026-08", "stars": 5}],
      "evidence": "reviews/2026-08-screenshot-01.png"
    }
  }
}
