{
  "$doc": "journey（角色漫游）设计令牌。皮肤是本项目自己的「旅行文具」一套：顶部一张车票当信息层（路线 + 站点 + 当前站名）、每站一张航空信封边的明信片、开场翻牌站牌大字、片尾这张车票滑到画面中间展开、检票打孔、翻面露出产品名。节奏、视差、减速这些骨架参数来自对这类片子的拆解（styles/journey/STYLE.md），字号按本仓库底线放大。二创换皮只改这里：themes 换整体配色，scenes 换道具配色槽位和笑点时刻；城市楼群、类别色、角色颜色在 art 键里改（见 art/README.md），类别色 = 该街区美术主色。原创性口径见 styles/journey/originality.md",
  "defaultTheme": "post-green",
  "themes": {
    "post-green": {
      "$doc": "默认：邮路绿。石墨描边 + 邮政绿车票票根 + 荧光青柠强调；浅湖青纸色底",
      "bg": "#C6E1E7",
      "ink": "#23262E",
      "inkSoft": "#5F6B66",
      "brand": "#1B6B2F",
      "brandInk": "#FFFFFF",
      "accent": "#7CFC3A",
      "card": "#FFFFFF",
      "paper": "#FBFCF8",
      "flap": "#262A33",
      "flapInk": "#F4F6F2",
      "flapHi": "#7CFC3A",
      "burstYellow": "#C6F7B4",
      "burstBlue": "#E3ECEF",
      "burstGray": "#DCDFE3",
      "moon": "#F6F4E8"
    },
    "plum-ticket": {
      "$doc": "二创示范：酒红车票。冷雾蓝纸底 + 酒红票根 + 苔绿强调",
      "bg": "#DBDFF0",
      "ink": "#2B2A31",
      "inkSoft": "#6A6570",
      "brand": "#7A1030",
      "brandInk": "#FFFFFF",
      "accent": "#4B760A",
      "card": "#FFFFFF",
      "paper": "#FCFBF9",
      "flap": "#2B2A31",
      "flapInk": "#F5F3F0",
      "flapHi": "#C6F7B4",
      "burstYellow": "#D2F8C0",
      "burstBlue": "#E6E8EC",
      "burstGray": "#DCDCE0",
      "moon": "#F6F4E8"
    }
  },
