  "sky": {"$doc": "天色按街区自动分配：最后一个街区是夜，倒数第二个黄昏，倒数第三个暖色（≥5 个街区时），其余白天；两站之间线性过渡", "phases": ["day", "warm", "dusk", "night"]},
  "scenes": {
    "$doc": "街区类型 = 美术街区外观（plan.ts 的 ART_KIND）+ 道具 + 一个笑点（gag）。props = 道具配色槽位：main / deep / mid / accent 取该街区美术配色（art/palette.ts 的 DISTRICT，可被 art.district 覆盖），white / ink 是纸白和描边色，也可以直接写 #RRGGBB。fits = 能配的背景天际线（modern / street / oldtown，checks.mjs 按它拦）；night = 夜景街区（只放最后一站）；item = catch 笑点抛来的东西。expr 里的 lean = 后仰下腰（道口）、offer = 递出车票 / 文牒。slow = [从第几拍, 到第几拍, 相机速度倍数]；gagAt = 道具正好到角色面前的那一拍；expr = [[起拍, 止拍, 表情], ...]；burst/bubble = 默认拟声字和台词（分镜可覆盖）；burstAt/bubbleAt = 第几拍弹出；sfx = 音效卡点 [拍, 音效, 音量]",
    "crossing": {
      "name": {"zh": "道口", "en": "Crossing"},
      "gag": "duck",
      "props": ["main", "white", "accent", "deep"],
      "slow": [3, 5.6, 0.6], "gagAt": 4.3,
      "expr": [[2.6, 3.2, "surprised"], [3.2, 5.4, "lean"], [5.4, 6.6, "relaxed"]],
