    "idlePxPerSec": 65,
    "cruisePxPerSec": 553,
    "parallax": {"artFar": 0.12, "artMid": 0.55, "board": 0.42, "near": 1},
    "rampSec": 0.25,
    "boardRiseBeat": 0.3,
    "boardFoldBeat": 7.2,
    "boardReadBeat": 2.5,
    "boardReadX": 0.6,
    "takeoffFrom": 0.45,
    "finaleStopSec": 1.3,
