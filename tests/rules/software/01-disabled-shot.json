          "after": {
            "src": "b.jpg"
          },
          "consent": true,
          "retouched": false,
          "subVertical": "hair"
        }
      },
      {
        "type": "endCard",
        "dur": 3,
        "mood": 0.3,
        "params": {
          "brand": "测试助手",
          "slogan": "整理\n{更省心}"
        }
      }
    ]
  },
  "expect": {
    "block": [
      "不开放镜头 beforeAfter"
    ]
  }
}
