    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "brewreel",
    "deepseek-harness",
    "remotion",
    "video",
    "skill"
  ],
  "license": "Apache-2.0",
  "author": "Liu Weijie (Finderchangchang)",
  "homepage": "https://brewreel.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Finderchangchang/brewreel",
    "directory": "integrations/deepseek-harness"
  },
  "bugs": {
    "url": "https://github.com/Finderchangchang/brewreel/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "scripts": {
    "sync": "node scripts/sync-skill.mjs",
